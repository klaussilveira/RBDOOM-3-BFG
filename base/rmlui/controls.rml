<rml>
<head>
    <title>Controls</title>
    <link type="text/rcss" href="doom3_theme.rcss"/>
    <style>
        body {
            background-color: #000000;
        }

        #header {
            margin-top: 80dp;
            margin-bottom: 40dp;
            text-align: center;
        }

        #title {
            font-size: 48dp;
            font-weight: bold;
            color: #ff6600;
            text-transform: uppercase;
            letter-spacing: 4dp;
        }

        #options-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10dp;
            margin: 0 auto;
            width: 500dp;
        }

        .option-row {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            height: 44dp;
            background-color: #1a1a1a;
            border: 2dp solid #404040;
            padding: 0 20dp;
        }

        .option-row:hover {
            background-color: #252525;
            border-color: #ff6600;
        }

        .option-row:focus {
            background-color: #252525;
            border-color: #ff6600;
        }

        .option-label {
            font-size: 16dp;
            color: #c0c0c0;
        }

        .option-value {
            font-size: 16dp;
            color: #ff6600;
            font-weight: bold;
        }

        .menu-btn {
            width: 100%;
            height: 44dp;
            background-color: #1a1a1a;
            border: 2dp solid #404040;
            font-size: 16dp;
            font-weight: bold;
            color: #c0c0c0;
            text-align: left;
            padding-left: 20dp;
            padding-top: 11dp;
            cursor: pointer;
        }

        .menu-btn:hover {
            background-color: #252525;
            border-color: #ff6600;
            color: #ffffff;
        }

        .menu-btn:focus {
            background-color: #252525;
            border-color: #ff6600;
            color: #ffffff;
        }

        .slider-container {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 10dp;
        }

        .slider-bar {
            width: 120dp;
            height: 8dp;
            background-color: #303030;
            border: 1dp solid #505050;
        }

        .slider-fill {
            height: 100%;
            background-color: #ff6600;
            width: 50%;
        }

        #back-hint {
            position: absolute;
            bottom: 60dp;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 14dp;
            color: #404040;
        }

        #controls-hint {
            position: absolute;
            bottom: 90dp;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 12dp;
            color: #505050;
        }
    </style>
</head>
<body id="body" class="menu-screen">
    <div id="header">
        <div id="title">Controls</div>
    </div>

    <div id="options-container">
        <button class="menu-btn" data-action="open_keyboard_bindings" tabindex="1" autofocus>
            Keyboard Bindings
        </button>

        <button class="menu-btn" data-action="open_gamepad_config" tabindex="2">
            Gamepad Configuration
        </button>

        <div class="option-row" data-action="toggle_gamepad" tabindex="3">
            <span class="option-label">Gamepad Enabled</span>
            <span class="option-value" id="gamepad-value">Off</span>
        </div>

        <div class="option-row" data-action="toggle_invert_mouse" tabindex="4">
            <span class="option-label">Invert Mouse</span>
            <span class="option-value" id="invert-value">Off</span>
        </div>

        <div class="option-row" data-action="adjust_mouse_sens" tabindex="5">
            <span class="option-label">Mouse Sensitivity</span>
            <div class="slider-container">
                <div class="slider-bar">
                    <div class="slider-fill" id="mouse-sens-fill" style="width: 50%;"></div>
                </div>
                <span class="option-value" id="mouse-sens-value">50</span>
            </div>
        </div>
    </div>

    <div id="controls-hint">Use LEFT/RIGHT to adjust values</div>
    <div id="back-hint">Press ESC to go back</div>
</body>
</rml>
