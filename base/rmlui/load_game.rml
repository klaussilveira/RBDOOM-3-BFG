<rml>
<head>
    <title>Load Game</title>
    <link type="text/rcss" href="doom3_theme.rcss"/>
    <style>
        body {
            background-color: #000000;
        }

        #header {
            margin-top: 80dp;
            margin-bottom: 40dp;
            text-align: center;
        }

        #title {
            font-size: 48dp;
            font-weight: bold;
            color: #ff6600;
            text-transform: uppercase;
            letter-spacing: 4dp;
        }

        #content-container {
            display: flex;
            flex-direction: row;
            justify-content: center;
            gap: 40dp;
            margin: 0 80dp;
        }

        #save-list {
            width: 400dp;
            display: flex;
            flex-direction: column;
            gap: 8dp;
        }

        .save-item {
            width: 100%;
            height: 44dp;
            background-color: #1a1a1a;
            border: 2dp solid #404040;
            font-size: 16dp;
            color: #c0c0c0;
            text-align: left;
            padding: 10dp 15dp;
            cursor: pointer;
        }

        .save-item:hover {
            background-color: #252525;
            border-color: #ff6600;
            color: #ffffff;
        }

        .save-item:focus {
            background-color: #252525;
            border-color: #ff6600;
            color: #ffffff;
        }

        .save-item:active {
            background-color: #ff6600;
            color: #000000;
        }

        .save-item.autosave {
            color: #ffcc00;
        }

        .save-item.quicksave {
            color: #ff9900;
        }

        #save-details {
            width: 300dp;
            background-color: #0d0d0d;
            border: 2dp solid #303030;
            padding: 20dp;
        }

        #details-title {
            font-size: 18dp;
            font-weight: bold;
            color: #ff6600;
            margin-bottom: 15dp;
        }

        .detail-row {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            margin-bottom: 8dp;
        }

        .detail-label {
            font-size: 14dp;
            color: #606060;
        }

        .detail-value {
            font-size: 14dp;
            color: #c0c0c0;
        }

        #no-saves {
            text-align: center;
            font-size: 18dp;
            color: #606060;
            padding: 40dp;
        }

        #back-hint {
            position: absolute;
            bottom: 60dp;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 14dp;
            color: #404040;
        }

        #controls-hint {
            position: absolute;
            bottom: 90dp;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 12dp;
            color: #505050;
        }
    </style>
</head>
<body id="body" class="menu-screen">
    <div id="header">
        <div id="title">Load Game</div>
    </div>

    <div id="content-container">
        <div id="save-list">
            <div id="no-saves">No saved games found</div>
        </div>

        <div id="save-details">
            <div id="details-title">Save Details</div>
            <div class="detail-row">
                <span class="detail-label">Map:</span>
                <span class="detail-value" id="detail-map">---</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Date:</span>
                <span class="detail-value" id="detail-date">---</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Playtime:</span>
                <span class="detail-value" id="detail-time">---</span>
            </div>
        </div>
    </div>

    <div id="controls-hint">Press ENTER to load, DEL to delete</div>
    <div id="back-hint">Press ESC to go back</div>
</body>
</rml>
