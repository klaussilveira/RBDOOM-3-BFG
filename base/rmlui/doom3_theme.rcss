/*
 * Doom 3 BFG Edition - RmlUI Theme
 * Dark theme with orange accents matching the classic Doom 3 aesthetic
 */

/* Base body styles */
body {
    font-family: LatoLatin;
    font-size: 16dp;
    color: #c0c0c0;
    background-color: #000000;
    width: 100%;
    height: 100%;
}

body.menu-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Container styles */
.container {
    width: 80%;
    max-width: 800dp;
    margin: 0 auto;
    padding: 20dp;
}

.centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Logo/Title area */
#logo, .logo {
    margin-bottom: 40dp;
    text-align: center;
}

#logo img, .logo img {
    max-width: 400dp;
    height: auto;
}

/* Title text */
h1, .title {
    font-size: 48dp;
    font-weight: bold;
    color: #ff6600;
    text-align: center;
    margin-bottom: 20dp;
    text-transform: uppercase;
    letter-spacing: 2dp;
}

h2, .subtitle {
    font-size: 24dp;
    color: #808080;
    text-align: center;
    margin-bottom: 30dp;
}

/* Navigation menu */
nav, .menu-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10dp;
    margin: 20dp 0;
}

/* Button styles */
button, .menu-button {
    display: block;
    width: 300dp;
    height: 50dp;
    margin: 8dp auto;
    padding: 12dp 24dp;
    background-color: #1a1a1a;
    border: 2dp solid #404040;
    font-family: LatoLatin;
    font-size: 20dp;
    font-weight: bold;
    color: #c0c0c0;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1dp;
    cursor: pointer;
}

button:hover, .menu-button:hover {
    background-color: #2a2a2a;
    border-color: #ff6600;
    color: #ffffff;
}

button:focus, .menu-button:focus {
    background-color: #2a2a2a;
    border-color: #ff6600;
    color: #ffffff;
    outline: none;
}

button:active, .menu-button:active {
    background-color: #ff6600;
    border-color: #ff8800;
    color: #000000;
}

button:disabled, .menu-button:disabled {
    background-color: #0d0d0d;
    border-color: #202020;
    color: #404040;
    cursor: default;
}

/* Game selector carousel */
#game-carousel, .game-carousel {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 20dp;
    margin: 40dp 0;
}

/* Game selection button */
.game-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 200dp;
    height: 280dp;
    padding: 10dp;
    background-color: #1a1a1a;
    border: 3dp solid #303030;
    opacity: 0.7;
    cursor: pointer;
}

.game-button:hover {
    opacity: 1.0;
    border-color: #606060;
}

.game-button:focus, .game-button.selected {
    opacity: 1.0;
    border-color: #ff6600;
    background-color: #252525;
}

.game-button img {
    width: 180dp;
    height: 220dp;
    margin-bottom: 10dp;
}

.game-button span, .game-button .game-title {
    font-size: 18dp;
    font-weight: bold;
    color: #c0c0c0;
    text-align: center;
    text-transform: uppercase;
}

.game-button:hover span, .game-button:focus span,
.game-button:hover .game-title, .game-button:focus .game-title {
    color: #ffffff;
}

/* Navigation hints */
#nav-hint, .nav-hint {
    position: absolute;
    bottom: 40dp;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 14dp;
    color: #606060;
}

/* Separator line */
.separator {
    width: 60%;
    height: 2dp;
    background-color: #303030;
    margin: 20dp auto;
}

/* Version/copyright text */
.version-text, .copyright {
    position: absolute;
    bottom: 10dp;
    right: 20dp;
    font-size: 12dp;
    color: #404040;
}

/* Panel styles for dialogs */
.panel {
    background-color: #151515;
    border: 2dp solid #303030;
    padding: 20dp;
    margin: 10dp;
}

.panel-header {
    font-size: 20dp;
    font-weight: bold;
    color: #ff6600;
    margin-bottom: 15dp;
    padding-bottom: 10dp;
    border-bottom: 1dp solid #303030;
}

/* Scrollbar styling */
scrollbarvertical {
    width: 12dp;
    background-color: #1a1a1a;
}

scrollbarvertical slidertrack {
    background-color: #0a0a0a;
}

scrollbarvertical sliderbar {
    background-color: #404040;
    width: 10dp;
    margin: 1dp;
}

scrollbarvertical sliderbar:hover {
    background-color: #606060;
}

/* Focus states for accessibility */
*:focus {
    outline: none;
}

/* Animation keyframes would go here if RmlUI supports them */

/* Utility classes */
.hidden {
    display: none;
}

.text-center {
    text-align: center;
}

.text-left {
    text-align: left;
}

.text-right {
    text-align: right;
}

.margin-top {
    margin-top: 20dp;
}

.margin-bottom {
    margin-bottom: 20dp;
}
